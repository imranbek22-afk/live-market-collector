# No API key required for Stooq free CSV HTTP.
# Optional knobs (defaults shown):

# Comma-separated Stooq symbols (suffix .us for US equities/ETFs)
TICKERS=aapl.us,msft.us,spy.us

# SQLite path (relative to project root)
DB_PATH=data/market.db

# CSV export directory
CSV_EXPORT_DIR=data/exports

# Dashboard / trends output directory
OUTPUT_DIR=output

# HTTP timeout seconds
HTTP_TIMEOUT=30

# Seconds between scheduled fetches (default: 3600 = 1 hour)
SCHEDULE_INTERVAL_SECONDS=3600

# Max retries on rate-limit / transient errors
MAX_RETRIES=3

# Base backoff seconds (doubles each retry)
BACKOFF_BASE_SECONDS=2

# Optional: override Stooq URL template (must contain {symbol})
# Default: https://stooq.com/q/d/l/?s={symbol}&i=d
# Offline mock: http://127.0.0.1:8765/q/d/l/?s={symbol}&i=d
# STOOQ_URL_TEMPLATE=https://stooq.com/q/d/l/?s={symbol}&i=d
